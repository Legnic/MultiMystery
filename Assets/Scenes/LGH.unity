  m_Script: {fileID: 11500000, guid: 819b4fb00f5a66c498c1a61d568a449b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LGH.PaperNote
  title: "\uAD8C\uCD1D \uC0AC\uC6A9 \uC124\uBA85\uC11C"
  body: "\uC774 \uAD8C\uCD1D\uC5D0\uB294 \uCD1D\uC54C\uC774 <b>\uB2E8 \uD55C \uBC1C</b> \uB4E4\uC5B4 \uC788\uB2E4. \uB450 \uBC88\uC9F8\uB294 \uC5C6\uB2E4.\n\n\uC774 \uC800\uD0DD\uC758 \uBCF4\uBB3C\uC740 \uC624\uC9C1 \uD55C \uC0AC\uB78C\uC758 \uBAAB\uC774\uB2E4.\n\n\uC774\uAC83\uC744 \uC0AC\uC6A9\uD574 \uB3D9\uB8CC\uB97C \uC4F0\uB7EC\uB728\uB9AC\uACE0\n\uBCF4\uBB3C\uC744 \uB3C5\uCC28\uC9C0\uD560 \uAC83\uC778\uAC00?\n\n\uC544\uB2C8\uBA74 \uB05D\uAE4C\uC9C0 \uD568\uAED8 \uB098\uAC08 \uAC83\uC778\uAC00.\n\n<i>\uC120\uD0DD\uC740 \uB2F9\uC2E0\uC758 \uBAAB\uC774\uB2E4.</i>"
  prompt: "[E] \uC124\uBA85\uC11C \uC77D\uAE30"
  choiceA: 
  choiceB: 
  privateMessageA: 
  privateMessageB: 
  announceB: 
