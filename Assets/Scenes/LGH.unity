--- !u!114 &241534540
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 241534539}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 819b4fb00f5a66c498c1a61d568a449b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LGH.PaperNote
  title: "\uC811\uD78C \uCABD\uC9C0"
  body: "\uC774 \uC5F4\uC1E0\uB97C \uCC3E\uC740 \uC0AC\uB78C\uC740 \uC9C0\uAE08 \uB2F9\uC2E0\uBFD0\uC774\uB2E4.\n\n\uB2E4\uB77D\uBC29\uC5D0\uB294 \uB2E8 \uD55C \uC0AC\uB78C\uB9CC \uAC00\uC9C8 \uC218 \uC788\uB294 \uBCF4\uBB3C\uC774 \uC7A0\uB4E4\uC5B4 \uC788\uB2E4\uACE0 \uD55C\uB2E4.\n\n\uC5F4\uC1E0\uB97C \uCC3E\uC558\uB2E4\uB294 \uC0AC\uC2E4\uC744 \uB3D9\uB8CC\uC5D0\uAC8C \uC54C\uB9B4 \uAC83\uC778\uAC00,\n\uC544\uB2C8\uBA74 \uD63C\uC790\uB9CC\uC758 \uBE44\uBC00\uB85C \uB0A8\uACA8\uB458 \uAC83\uC778\uAC00?\n\n<i>- \uD55C \uBC88 \uC815\uD558\uBA74 \uB418\uB3CC\uB9B4 \uC218 \uC5C6\uB2E4 -</i>"
  prompt: "[E] \uCABD\uC9C0 \uD3BC\uCCD0\uBCF4\uAE30"
  choiceA: "\uBE44\uBC00\uB85C \uD55C\uB2E4"
  choiceB: "\uBAA8\uB450\uC5D0\uAC8C \uB9D0\uD55C\uB2E4"
  privateMessageA: "\uB2F9\uC2E0\uC740 \uC785\uC744 \uB2E4\uBB3C\uAE30\uB85C \uD588\uB2E4. \uB2E4\uB77D\uBC29 \uC5F4\uC1E0\uC758 \uC874\uC7AC\uB294 \uB2F9\uC2E0\uB9CC \uC54C\uACE0 \uC788\uB2E4."
  privateMessageB: "\uB2F9\uC2E0\uC740 \uB3D9\uB8CC\uB4E4\uC5D0\uAC8C \uC5F4\uC1E0\uB97C \uCC3E\uC558\uB2E4\uACE0 \uC54C\uB838\uB2E4."
  announceB: "{name} : \"\uBCC4 \uC0C1\uC790\uC5D0\uC11C \uB2E4\uB77D\uBC29 \uC5F4\uC1E0\uB97C \uCC3E\uC558\uC5B4!\""
