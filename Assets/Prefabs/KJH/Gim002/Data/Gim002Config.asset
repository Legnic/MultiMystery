  msgCurtainClosed: "\uCEE4\uD2BC\uC774 \uB2EB\uD600 \uC788\uB2E4"
  msgNotReady: "\uC190\uC7A1\uC774\uAC00 \uAFC8\uCA4D\uB3C4 \uD558\uC9C0 \uC54A\uB294\uB2E4"
  msgSlotLocked: "\uB2E8\uB2E8\uD788 \uACE0\uC815\uB418\uC5B4 \uBE60\uC9C0\uC9C0 \uC54A\uB294\uB2E4"
  msgWrongSlotDoll: "\uC778\uD615\uC740 \uBB34\uB300 \uBC14\uB2E5\uC758 \uAF42\uC774\uC5D0 \uC138\uC6CC\uC57C \uD55C\uB2E4"
  msgWrongSlotBg: "\uBC30\uACBD\uCE74\uB4DC\uB294 \uBB34\uB300 \uB4A4\uCABD \uC2AC\uB86F\uC5D0 \uAF42\uC544\uC57C \uD55C\uB2E4"
  msgWrongKey: "\uBB38\uC591\uC774 \uB9DE\uC9C0 \uC54A\uB294\uB2E4"
  msgComplete: "\uC778\uD615\uADF9\uC774 \uB05D\uB0AC\uB2E4. \uC5B4\uB514\uC120\uAC00 \uBC15\uC218 \uC18C\uB9AC\uC640 \uD568\uAED8 \uBB38\uC774 \uC5F4\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4."
